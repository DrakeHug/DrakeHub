--==================================================
-- GUI UPDATE
--==================================================

local function updateGUI()

	if ENABLED then

		toggle.Text = "Auto Combat: ON"
		toggle.BackgroundColor3 =
			Color3.fromRGB(0, 170, 110)

	else

		toggle.Text = "Auto Combat: OFF"
		toggle.BackgroundColor3 =
			Color3.fromRGB(55, 55, 60)

	end
end

toggle.MouseButton1Click:Connect(function()

	ENABLED = not ENABLED

	if not ENABLED then
		currentTarget = nil
	end

	updateGUI()
end)

distanceBox.FocusLost:Connect(function()

	local value =
		tonumber(distanceBox.Text)

	if value then

		ATTACK_DISTANCE =
			math.clamp(value, 1.5, 8)

		distanceBox.Text =
			tostring(ATTACK_DISTANCE)

	else

		distanceBox.Text =
			tostring(ATTACK_DISTANCE)

	end
end)

