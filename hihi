--==================================================
-- SETTINGS
--==================================================

local ENABLED = true

local SEARCH_RANGE = 150
local ATTACK_DISTANCE = 3

local TARGET_INTERVAL = 0.25
local ATTACK_INTERVAL = 0.5

--==================================================
-- VARIABLES
--==================================================

local enemyFolders = {}
local currentTarget = nil

local targetTimer = 0
local attackTimer = 0

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character
end

local function getPlayerRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- ENEMY CHECK
--==================================================

local function getEnemyRoot(model)
	if not model or not model:IsA("Model") then
		return nil
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if humanoid and root then
		return root
	end

	return nil
end

local function isEnemy(model)

	if not model:IsA("Model") then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass("Humanoid")

	local root =
		model:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	-- Không target Player
	if Players:GetPlayerFromCharacter(model) then
		return false
	end

	return true
end

--==================================================
-- CACHE enemyFolder
--==================================================

local function rebuildFolders()

	table.clear(enemyFolders)

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("Folder")
			and object.Name == "enemyFolder" then

			table.insert(enemyFolders, object)

		end
	end
end

rebuildFolders()

workspace.DescendantAdded:Connect(function(object)

	if object:IsA("Folder")
		and object.Name == "enemyFolder" then

		rebuildFolders()
	end
end)

workspace.DescendantRemoving:Connect(function(object)

	if object:IsA("Folder")
		and object.Name == "enemyFolder" then

		rebuildFolders()
	end
end)

--==================================================
-- FIND NEAREST
--==================================================

local function findNearestEnemy()

	local playerRoot =
		getPlayerRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RANGE

	for _, folder in ipairs(enemyFolders) do

		if folder.Parent then

			for _, model in ipairs(folder:GetChildren()) do

				if isEnemy(model) then

					local root =
						getEnemyRoot(model)

					local distance =
						(playerRoot.Position - root.Position).Magnitude

					if distance < nearestDistance then

						nearestDistance = distance
						nearest = model

					end
				end
			end
		end
	end

	return nearest
end

--==================================================
-- MOVE TO ENEMY
--==================================================

local function moveNearEnemy(enemy)

	if not isEnemy(enemy) then
		return
	end

	local playerRoot =
		getPlayerRoot()

	local enemyRoot =
		getEnemyRoot(enemy)

	if not playerRoot or not enemyRoot then
		return
	end

	local difference =
		playerRoot.Position - enemyRoot.Position

	local distance =
		difference.Magnitude

	if distance <= ATTACK_DISTANCE then

		-- Chỉ xoay nhìn enemy
		playerRoot.CFrame =
			CFrame.lookAt(
				playerRoot.Position,
				enemyRoot.Position
			)

		return
	end

	local direction

	if distance > 0.01 then
		direction = difference.Unit
	else
		direction = Vector3.new(0, 0, 1)
	end

	local position =
		enemyRoot.Position
		+ direction * ATTACK_DISTANCE

	-- Giữ độ cao hiện tại
	position = Vector3.new(
		position.X,
		playerRoot.Position.Y,
		position.Z
	)

	playerRoot.CFrame =
		CFrame.lookAt(
			position,
			enemyRoot.Position
		)
end

--==================================================
-- AUTO ATTACK
--==================================================

local function attack()

	if not currentTarget then
		return
	end

	if not isEnemy(currentTarget) then
		return
	end

	-- Gọi server đánh
	remote:FireServer(currentTarget)

	-- Nếu đang cầm Tool thì kích hoạt animation/attack
	local character =
		getCharacter()

	if character then

		local tool =
			character:FindFirstChildOfClass("Tool")

		if tool then
			tool:Activate()
		end
	end
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function(deltaTime)

	if not ENABLED then
		return
	end

	targetTimer += deltaTime
	attackTimer += deltaTime

	-- Tìm target 4 lần/giây
	if targetTimer >= TARGET_INTERVAL then

		targetTimer = 0

		if not currentTarget
			or not isEnemy(currentTarget) then

			currentTarget =
				findNearestEnemy()

		end
	end

	if currentTarget
		and isEnemy(currentTarget) then

		moveNearEnemy(currentTarget)

		if attackTimer >= ATTACK_INTERVAL then

			attackTimer = 0

			attack()
		end

	else

		currentTarget = nil

	end
end)

