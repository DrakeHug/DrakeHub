local function updateGUI()

	if ENABLED then

		toggle.Text =
			"Auto Combat: ON"

		toggle.BackgroundColor3 =
			Color3.fromRGB(0, 170, 110)

	else

		toggle.Text =
			"Auto Combat: OFF"

		toggle.BackgroundColor3 =
			Color3.fromRGB(60, 60, 65)

	end
end

toggle.MouseButton1Click:Connect(function()

	ENABLED =
		not ENABLED

	if not ENABLED then
		currentTarget = nil
	end

	updateGUI()
end)

