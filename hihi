	["Burly Enforcer"] = true,
	["Harpoon Gunner"] = true,
	["Raider"] = true
}

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character
end

local function getRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character.PrimaryPart
end

--==================================================
-- LẤY PART CỦA QUÁI
--==================================================

local function getEnemyPart(enemy)

	-- Ưu tiên HumanoidRootPart
	local root = enemy:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	-- Nếu Model có PrimaryPart
	if enemy:IsA("Model") and enemy.PrimaryPart then
		return enemy.PrimaryPart
	end

	-- Tìm bất kỳ BasePart nào
	for _, object in ipairs(enemy:GetDescendants()) do

		if object:IsA("BasePart") then
			return object
		end

	end

	return nil
end

--==================================================
-- TÌM ENEMY FOLDER
--==================================================

local function getEnemyFolders()

	local folders = {}

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("Folder")
			and object.Name == "enemyFolder" then

			table.insert(folders, object)

		end
	end

	return folders
end

--==================================================
-- TÌM QUÁI GẦN NHẤT
--==================================================

local function getNearestEnemy()

	local playerRoot = getRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = RANGE

	local folders = getEnemyFolders()

	for _, folder in ipairs(folders) do

		for _, enemy in ipairs(folder:GetChildren()) do

			-- Chỉ nhận các tên quái đã cho phép
			if AllowedEnemies[enemy.Name] then

				local humanoid =
					enemy:FindFirstChildOfClass("Humanoid")

				local enemyPart =
					getEnemyPart(enemy)

				if humanoid
					and humanoid.Health > 0
					and enemyPart then

					local distance =
						(playerRoot.Position
						- enemyPart.Position).Magnitude

					if distance < nearestDistance then

						nearestDistance = distance
						nearest = enemy

					end
				end
			end
		end
	end

	return nearest
end

--==================================================
-- BAY TRÊN ĐẦU QUÁI
--==================================================

local function moveAboveEnemy(enemy)

	local playerRoot = getRoot()

	if not playerRoot then
		return
	end

	local enemyPart =
		getEnemyPart(enemy)

	if not enemyPart then
		return
	end

	local position =
		enemyPart.Position
	+ Vector3.new(0, HEIGHT, 0)

	playerRoot.CFrame =
		CFrame.lookAt(
			position,
			enemyPart.Position
		)
end

--==================================================
-- AUTO CLICK / ACTIVATE TOOL
--==================================================

local function autoClick()

	if os.clock() - lastClick < CLICK_COOLDOWN then
		return
	end

	lastClick = os.clock()

	local character = getCharacter()

	if not character then
		return
	end

	-- Tìm Tool đang cầm
	local tool = character:FindFirstChildOfClass("Tool")

	if tool then

		-- Kích hoạt Tool giống click chuột
		tool:Activate()

		return
	end

	-- Nếu chưa cầm Tool, tìm Tool trong Backpack
	local backpack = player:FindFirstChild("Backpack")

	if backpack then

		local backpackTool =
			backpack:FindFirstChildOfClass("Tool")

		if backpackTool then

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if humanoid then
				humanoid:EquipTool(backpackTool)
			end

		end
	end
end

--==================================================
-- Q
--==================================================

local function useQ()

	if os.clock() - lastQ < Q_COOLDOWN then
		return
	end

	lastQ = os.clock()

	-- Gửi phím Q trong game của bạn
	-- Phần skill thật nên xử lý ở server
	print("Q SKILL")
end

--==================================================
-- E
--==================================================

local function useE()

