--// AUTO DUNGEON COMBAT
--// Đặt LocalScript này vào:
--// StarterPlayer > StarterPlayerScripts
--
--// Quái phải nằm trong:
--// Workspace > Mobs
--
--// Mỗi quái cần:
--// Humanoid
--// HumanoidRootPart

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local AUTO_COMBAT = true

local RANGE = 100
local HEIGHT = 8

local ATTACK_DAMAGE = 20
local Q_DAMAGE = 50
local E_DAMAGE = 80

local ATTACK_COOLDOWN = 0.5
local Q_COOLDOWN = 3
local E_COOLDOWN = 5

local lastAttack = 0
local lastQ = 0
local lastE = 0

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character
end

local function getRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- TÌM QUÁI GẦN NHẤT
--==================================================

local function getNearestMob()
	local root = getRoot()

	if not root then
		return nil
	end

	local mobsFolder = workspace:FindFirstChild("Mobs")

	if not mobsFolder then
		return nil
	end

	local nearestMob = nil
	local nearestDistance = RANGE

	for _, mob in ipairs(mobsFolder:GetChildren()) do

		local humanoid = mob:FindFirstChildOfClass("Humanoid")
		local mobRoot = mob:FindFirstChild("HumanoidRootPart")

		if humanoid
			and mobRoot
			and humanoid.Health > 0 then

			local distance =
				(root.Position - mobRoot.Position).Magnitude

			if distance < nearestDistance then
				nearestDistance = distance
				nearestMob = mob
			end
		end
	end

	return nearestMob
end

--==================================================
-- BAY / TELE TRÊN ĐẦU QUÁI
--==================================================

local function moveAboveMob(mob)
	local root = getRoot()

	if not root then
		return
	end

	if not mob then
		return
	end

	local mobRoot = mob:FindFirstChild("HumanoidRootPart")

	if not mobRoot then
		return
	end

	local targetPosition =
		mobRoot.Position + Vector3.new(0, HEIGHT, 0)

	root.CFrame = CFrame.lookAt(
		targetPosition,
		mobRoot.Position
	)
end

--==================================================
-- GÂY DAMAGE
--==================================================

local function damageMob(mob, damage)
	if not mob then
		return
	end

	local humanoid =
		mob:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	humanoid:TakeDamage(damage)
end

--==================================================
-- AUTO ATTACK
--==================================================

local function attack(mob)
	if os.clock() - lastAttack < ATTACK_COOLDOWN then
		return
	end

	lastAttack = os.clock()

	damageMob(mob, ATTACK_DAMAGE)
end

--==================================================
-- Q SKILL
--==================================================

local function useQ(mob)
	if os.clock() - lastQ < Q_COOLDOWN then
		return
	end

	lastQ = os.clock()

	damageMob(mob, Q_DAMAGE)

	-- Hiệu ứng đơn giản
	local root = mob:FindFirstChild("HumanoidRootPart")

	if root then

		local effect = Instance.new("Part")

		effect.Shape = Enum.PartType.Ball
		effect.Size = Vector3.new(4,4,4)
		effect.Material = Enum.Material.Neon
		effect.Color = Color3.fromRGB(0,170,255)

		effect.Anchored = true
		effect.CanCollide = false

		effect.CFrame = root.CFrame

		effect.Parent = workspace

		task.delay(0.15, function()
			if effect then
				effect:Destroy()
			end
		end)
	end
end

--==================================================
-- E SKILL
--==================================================

local function useE(mob)
	if os.clock() - lastE < E_COOLDOWN then
		return
	end

	lastE = os.clock()

	damageMob(mob, E_DAMAGE)

	-- Hiệu ứng đơn giản
	local root = mob:FindFirstChild("HumanoidRootPart")

	if root then

		local effect = Instance.new("Explosion")

		effect.Position = root.Position
		effect.BlastRadius = 0
		effect.BlastPressure = 0

		effect.Parent = workspace
	end
end

--==================================================
-- AUTO COMBAT LOOP
--==================================================

RunService.Heartbeat:Connect(function()

	if not AUTO_COMBAT then
		return
	end

	local mob = getNearestMob()

	if not mob then
		return
	end

	-- Bay trên đầu
	moveAboveMob(mob)

	-- Đánh thường
	attack(mob)
end)

--==================================================
-- Q / E
--==================================================

UserInputService.InputBegan:Connect(function(input, processed)

	if processed then
		return
	end

	if not AUTO_COMBAT then
		return
	end

	local mob = getNearestMob()

	if not mob then
		return
	end

	if input.KeyCode == Enum.KeyCode.Q then

		useQ(mob)

	elseif input.KeyCode == Enum.KeyCode.E then

		useE(mob)

	end
end)

