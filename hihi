--==================================================
-- FIND NEAREST ENEMY
--==================================================

local function findNearestEnemy()

	local playerRoot =
		getPlayerRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RANGE

	for _, folder in ipairs(enemyFolders) do

		if folder.Parent then

			for _, enemy in ipairs(folder:GetChildren()) do

				if isEnemy(enemy) then

					local enemyRoot =
						getEnemyRoot(enemy)

					local distance =
						(playerRoot.Position
						- enemyRoot.Position).Magnitude

					if distance < nearestDistance then

						nearestDistance = distance
						nearest = enemy

					end
				end
			end
		end
	end

	return nearest
end

--==================================================
-- MOVE NEAR ENEMY
--==================================================

local function moveNearEnemy(enemy)

	if not isEnemy(enemy) then
		return
	end

	local playerRoot =
		getPlayerRoot()

	local enemyRoot =
		getEnemyRoot(enemy)

	if not playerRoot or not enemyRoot then
		return
	end

	local difference =
		playerRoot.Position - enemyRoot.Position

	local distance =
		difference.Magnitude

	-- Đã đủ gần
	if distance <= ATTACK_DISTANCE then

		playerRoot.CFrame =
			CFrame.lookAt(
				playerRoot.Position,
				enemyRoot.Position
			)

		return
	end

	local direction

	if distance > 0.01 then
		direction = difference.Unit
	else
		direction = Vector3.new(0, 0, 1)
	end

	local position =
		enemyRoot.Position
	+ direction * ATTACK_DISTANCE

	-- Không đổi độ cao
	position = Vector3.new(
		position.X,
		playerRoot.Position.Y,
		position.Z
	)

	playerRoot.CFrame =
		CFrame.lookAt(
			position,
			enemyRoot.Position
		)
end

--==================================================
-- AUTO ATTACK
--==================================================

local function attackTarget()

	if not currentTarget then
		return
	end

	if not isEnemy(currentTarget) then
		return
	end

	-- Gửi attack đến server
	remote:FireServer(currentTarget)

	-- Nếu đang cầm Tool thì kích hoạt Tool
	local character =
		getCharacter()

	if character then

		local tool =
			character:FindFirstChildOfClass("Tool")

		if tool then
			tool:Activate()
		end
	end
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function(delta)

	if not ENABLED then
		return
	end

	targetTimer += delta
	attackTimer += delta

	-- Không tìm target mỗi frame
	if targetTimer >= TARGET_UPDATE then

		targetTimer = 0

		if not currentTarget
			or not isEnemy(currentTarget) then

			currentTarget =
				findNearestEnemy()

		end
	end

	if currentTarget
		and isEnemy(currentTarget) then

		moveNearEnemy(currentTarget)

		if attackTimer >= ATTACK_COOLDOWN then

			attackTimer = 0

			attackTarget()

		end

	else

		currentTarget = nil

	end
end)

