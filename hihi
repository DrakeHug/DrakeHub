--==================================================
-- DRAKE SPEED SAVE - SERVER
--==================================================

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SpeedStore = DataStoreService:GetDataStore("DrakeSpeed_V1")

local DEFAULT_SPEED = 20
local MIN_SPEED = 16
local MAX_SPEED = 300

--==================================================
-- REMOTE
--==================================================

local Remote = ReplicatedStorage:FindFirstChild("DrakeSpeedRemote")

if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "DrakeSpeedRemote"
	Remote.Parent = ReplicatedStorage
end

--==================================================
-- DATA
--==================================================

local Speeds = {}

local function loadSpeed(player)
	local success, result = pcall(function()
		return SpeedStore:GetAsync("Player_" .. player.UserId)
	end)

	if success and typeof(result) == "number" then
		Speeds[player] = math.clamp(
			math.floor(result),
			MIN_SPEED,
			MAX_SPEED
		)
	else
		Speeds[player] = DEFAULT_SPEED
	end

	return Speeds[player]
end

local function saveSpeed(player)
	local speed = Speeds[player]

	if not speed then
		return
	end

	local success, err = pcall(function()
		SpeedStore:SetAsync(
			"Player_" .. player.UserId,
			speed
		)
	end)

	if not success then
		warn("[Drake Speed] Save failed:", err)
	end
end

--==================================================
-- PLAYER JOIN
--==================================================

Players.PlayerAdded:Connect(function(player)

	loadSpeed(player)

	player.CharacterAdded:Connect(function(character)

		local humanoid =
			character:WaitForChild("Humanoid", 10)

		if humanoid then
			task.wait(0.2)

			humanoid.WalkSpeed =
				Speeds[player] or DEFAULT_SPEED
		end

	end)

end)

--==================================================
-- CLIENT REQUEST
--==================================================

Remote.OnServerEvent:Connect(function(
	player,
	action,
	value
)

	if action == "GetSpeed" then

		Remote:FireClient(
			player,
			"Speed",
			Speeds[player] or DEFAULT_SPEED
		)

		return
	end

	if action == "SetSpeed" then

		if typeof(value) ~= "number" then
			return
		end

		value = math.clamp(
			math.floor(value),
			MIN_SPEED,
			MAX_SPEED
		)

		Speeds[player] = value

		local character = player.Character

		if character then

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if humanoid then
				humanoid.WalkSpeed = value
			end

		end

		saveSpeed(player)

	end

end)

--==================================================
-- PLAYER LEAVE
--==================================================

Players.PlayerRemoving:Connect(function(player)

	saveSpeed(player)

	Speeds[player] = nil

end)

--==================================================
-- SERVER SHUTDOWN
--==================================================

game:BindToClose(function()

	for _, player in Players:GetPlayers() do
		saveSpeed(player)
	end

	task.wait(2)

end)
