--==================================================
-- GUI UPDATE
--==================================================

local function updateGUI()

	if ENABLED then

		toggle.Text = "Auto Combat: ON"
		toggle.BackgroundColor3 =
			Color3.fromRGB(0,170,110)

	else

		toggle.Text = "Auto Combat: OFF"
		toggle.BackgroundColor3 =
			Color3.fromRGB(55,55,60)

	end
end

toggle.MouseButton1Click:Connect(function()

	ENABLED = not ENABLED

	updateGUI()

end)

distanceBox.FocusLost:Connect(function()

	local value = tonumber(distanceBox.Text)

	if value then

		ATTACK_DISTANCE =
			math.clamp(value, 1.5, 10)

		distanceBox.Text =
			tostring(ATTACK_DISTANCE)

	else

		distanceBox.Text =
			tostring(ATTACK_DISTANCE)

	end
end)

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function()

	if not ENABLED then
		targetLabel.Text = "Target: OFF"
		return
	end

	local enemy = getNearestEnemy()

	if not enemy then

		targetLabel.Text =
			"Target: Không có"

		return
	end

	targetLabel.Text =
		"Target: " .. enemy.Name

	-- Áp sát quái
	moveToEnemy(enemy)

	-- Auto attack
	autoAttack(enemy)

end)

