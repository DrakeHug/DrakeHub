--========================================================
-- SETTINGS
--========================================================

local ENABLED = true

-- Khoảng cách đứng với enemy
local ATTACK_DISTANCE = 3

-- Bán kính tìm enemy
local SEARCH_RANGE = 150

-- Bao lâu tìm target một lần
-- 0.2 = 5 lần / giây
local TARGET_UPDATE_TIME = 0.2

-- Auto attack
local ATTACK_COOLDOWN = 0.5

--========================================================
-- VARIABLES
--========================================================

local currentTarget = nil
local enemyFolders = {}

local lastTargetUpdate = 0
local lastAttack = 0

--========================================================
-- CHARACTER
--========================================================

local function getCharacter()

	return player.Character
end

local function getPlayerRoot()

	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--========================================================
-- ENEMY ROOT
--========================================================

local function getEnemyRoot(enemy)

	if not enemy or not enemy.Parent then
		return nil
	end

	-- Ưu tiên HumanoidRootPart
	local root = enemy:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	-- PrimaryPart
	if enemy:IsA("Model") and enemy.PrimaryPart then
		return enemy.PrimaryPart
	end

	-- Fallback:
	-- tìm BasePart đầu tiên
	for _, object in ipairs(enemy:GetChildren()) do

		if object:IsA("BasePart") then
			return object
		end

	end

	return nil
end

--========================================================
-- KIỂM TRA ENEMY
--========================================================

local function isValidEnemy(enemy)

	if not enemy then
		return false
	end

	if not enemy:IsA("Model") then
		return false
	end

	local humanoid =
		enemy:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	local root =
		getEnemyRoot(enemy)

	if not root then
		return false
	end

	-- Không target Player
	if Players:GetPlayerFromCharacter(enemy) then
		return false
	end

	return true
end

--========================================================
-- CACHE ENEMY FOLDER
--========================================================

local function rebuildEnemyFolders()

	table.clear(enemyFolders)

	for _, object in ipairs(workspace:GetDescendants()) do

		if object:IsA("Folder")
			and object.Name == "enemyFolder" then

			table.insert(enemyFolders, object)

		end
	end
end

-- Tìm folder lúc bắt đầu
rebuildEnemyFolders()

-- Nếu map mới được load sau đó,
-- cập nhật cache khi có enemyFolder mới.
workspace.DescendantAdded:Connect(function(object)

	if object:IsA("Folder")
		and object.Name == "enemyFolder" then

		rebuildEnemyFolders()

	end
end)

workspace.DescendantRemoving:Connect(function(object)

	if object:IsA("Folder")
		and object.Name == "enemyFolder" then

		rebuildEnemyFolders()

	end
end)

--========================================================
-- TÌM TARGET GẦN NHẤT
--========================================================

local function findNearestEnemy()

	local playerRoot =
		getPlayerRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RANGE

	for _, folder in ipairs(enemyFolders) do

		-- Folder có thể đã bị xóa
		if folder
			and folder.Parent then

			for _, enemy in ipairs(folder:GetChildren()) do

				if isValidEnemy(enemy) then

					local enemyRoot =
						getEnemyRoot(enemy)

					if enemyRoot then

						local distance =
							(
								playerRoot.Position
								- enemyRoot.Position
							).Magnitude

						if distance < nearestDistance then

							nearestDistance = distance
							nearest = enemy

						end
					end
				end
			end
		end
	end

	return nearest
end

--========================================================
-- DI CHUYỂN SÁT ENEMY
--========================================================

local function moveToEnemy(enemy)

	local playerRoot =
		getPlayerRoot()

	if not playerRoot then
		return
	end

	if not isValidEnemy(enemy) then
		return
	end

	local enemyRoot =
		getEnemyRoot(enemy)

	if not enemyRoot then
		return
	end

	local offset =
		playerRoot.Position
		- enemyRoot.Position

	-- Nếu đã đủ gần thì không teleport nữa.
	-- Đây giúp giảm cập nhật CFrame không cần thiết.
	if offset.Magnitude <= ATTACK_DISTANCE then

		playerRoot.CFrame =
			CFrame.lookAt(
				playerRoot.Position,
				enemyRoot.Position
			)

		return
	end

	local direction

	if offset.Magnitude > 0.01 then
		direction = offset.Unit
	else
		direction = Vector3.new(0, 0, 1)
	end

	local targetPosition =
		enemyRoot.Position
	+ direction * ATTACK_DISTANCE

	playerRoot.CFrame =
		CFrame.lookAt(
			targetPosition,
			enemyRoot.Position
		)
end

--========================================================
-- AUTO ATTACK
--========================================================

local function autoAttack()

	if os.clock() - lastAttack <
		ATTACK_COOLDOWN then

		return
	end

	lastAttack = os.clock()

	local character =
		getCharacter()

	if not character then
		return
	end

	-- Tool đang cầm
	local tool =
		character:FindFirstChildOfClass("Tool")

	if tool then

		tool:Activate()

	end
end

--========================================================
-- TARGET UPDATE
--========================================================

local function updateTarget()

	if not ENABLED then

		currentTarget = nil

		return
	end

	-- Target hiện tại vẫn sống thì giữ nguyên
	if isValidEnemy(currentTarget) then
		return
	end

	currentTarget =
		findNearestEnemy()
end

--========================================================
-- MAIN LOOP
--========================================================

local accumulator = 0

RunService.Heartbeat:Connect(function(deltaTime)

	if not ENABLED then
		return
	end

	-- Chỉ tìm target 5 lần / giây
	accumulator += deltaTime

	if accumulator >= TARGET_UPDATE_TIME then

		accumulator = 0

		updateTarget()

	end

	if currentTarget
		and isValidEnemy(currentTarget) then

		-- Áp sát
		moveToEnemy(currentTarget)

		-- Auto click / attack
		autoAttack()

	else

		currentTarget = nil

	end
end)

