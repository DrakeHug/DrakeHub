local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local ENABLED = true

-- Khoảng cách đứng trước quái
local ATTACK_DISTANCE = 3

-- Khoảng cách tối đa để tìm target
local SEARCH_RANGE = 150

-- Auto attack
local ATTACK_COOLDOWN = 0.5

--==================================================
-- ENEMIES
--==================================================

local AllowedEnemies = {
	["Burly Enforcer"] = true,
	["Harpoon Gunner"] = true,
	["Raider"] = true,
}

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character
end

local function getPlayerRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- ENEMY ROOT
--==================================================

local function getEnemyRoot(enemy)

	local root = enemy:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	if enemy:IsA("Model") and enemy.PrimaryPart then
		return enemy.PrimaryPart
	end

	for _, obj in ipairs(enemy:GetDescendants()) do
		if obj:IsA("BasePart") then
			return obj
		end
	end

	return nil
end

--==================================================
-- TÌM TẤT CẢ ENEMY FOLDER
--==================================================

local function getEnemyFolders()

	local folders = {}

	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("Folder")
			and obj.Name == "enemyFolder" then

			table.insert(folders, obj)

		end
	end

	return folders
end

--==================================================
-- TÌM QUÁI GẦN NHẤT
--==================================================

local function getNearestEnemy()

	local playerRoot = getPlayerRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RANGE

	for _, folder in ipairs(getEnemyFolders()) do

		for _, enemy in ipairs(folder:GetChildren()) do

			if AllowedEnemies[enemy.Name] then

				local humanoid =
					enemy:FindFirstChildOfClass("Humanoid")

				local enemyRoot =
					getEnemyRoot(enemy)

				if humanoid
					and humanoid.Health > 0
					and enemyRoot then

					local distance =
						(playerRoot.Position
						- enemyRoot.Position).Magnitude

					if distance < nearestDistance then

						nearestDistance = distance
						nearest = enemy

					end
				end
			end
		end
	end

	return nearest
end

--==================================================
-- ĐƯA NHÂN VẬT SÁT QUÁI
--==================================================

local function moveToEnemy(enemy)

	local playerRoot = getPlayerRoot()

	if not playerRoot then
		return
	end

	local enemyRoot =
		getEnemyRoot(enemy)

	if not enemyRoot then
		return
	end

	-- Vị trí ở phía trước quái
	local direction =
		(enemyRoot.Position - playerRoot.Position)

	if direction.Magnitude < 0.01 then
		return
	end

	direction = direction.Unit

	local targetPosition =
		enemyRoot.Position
	- direction * ATTACK_DISTANCE

	-- Giữ nguyên độ cao của player
	targetPosition = Vector3.new(
		targetPosition.X,
		enemyRoot.Position.Y,
		targetPosition.Z
	)

	playerRoot.CFrame =
		CFrame.lookAt(
			targetPosition,
			enemyRoot.Position
		)
end

--==================================================
-- AUTO ATTACK
--==================================================

local lastAttack = 0

local function autoAttack(enemy)

	if os.clock() - lastAttack <
		ATTACK_COOLDOWN then
		return
	end

	lastAttack = os.clock()

	local character = getCharacter()

	if not character then
		return
	end

	-- Nếu game của bạn dùng Tool,
	-- Activate sẽ kích hoạt attack của Tool.
	local tool =
		character:FindFirstChildOfClass("Tool")

	if tool then
		tool:Activate()
	end
end

--==================================================
-- Q / E
--==================================================

local function useSkill(key)

	local enemy = getNearestEnemy()

	if not enemy then
		return
	end

	print("Skill:", key, "Target:", enemy.Name)

	--================================================
	-- NỐI REMOTEEVENT / SKILL CỦA GAME BẠN Ở ĐÂY
	--================================================
	--
	-- Ví dụ nếu game của bạn có:
	--
	-- ReplicatedStorage.Remotes.Skill
	--
	-- thì có thể gọi:
	--
	-- SkillRemote:FireServer(key, enemy)
	--
	-- Mình không tự đoán tên RemoteEvent vì
	-- mỗi game có hệ thống skill khác nhau.
end

UserInputService.InputBegan:Connect(function(input, processed)

	if processed or not ENABLED then
		return
	end

	if input.KeyCode == Enum.KeyCode.Q then
		useSkill("Q")

	elseif input.KeyCode == Enum.KeyCode.E then
		useSkill("E")
	end
end)

