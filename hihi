--==================================================
-- UPDATE GUI
--==================================================

local function updateGUI()

	if AUTO_COMBAT then

		toggle.Text =
			"Auto Combat: ON"

		toggle.BackgroundColor3 =
			Color3.fromRGB(0,170,110)

		status.Text =
			"Q = Skill 1 | E = Skill 2"

	else

		toggle.Text =
			"Auto Combat: OFF"

		toggle.BackgroundColor3 =
			Color3.fromRGB(55,55,60)

		status.Text =
			"Đang tắt"

	end
end

toggle.MouseButton1Click:Connect(function()

	AUTO_COMBAT = not AUTO_COMBAT

	updateGUI()

end)

