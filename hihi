--==================================================
-- SETTINGS
--==================================================

local ENABLED = true

-- Tăng phạm vi tìm quái
local SEARCH_RANGE = 500

-- Khoảng cách đứng với quái
local ATTACK_DISTANCE = 4

-- Tần suất tìm target
local TARGET_UPDATE = 0.20

-- Tốc độ auto click
local ATTACK_COOLDOWN = 0.35

--==================================================
-- VARIABLES
--==================================================

local currentTarget = nil
local enemyFolders = {}

local targetTimer = 0
local attackTimer = 0

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character
end

local function getPlayerRoot()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- NPC ROOT
--==================================================

local function getEnemyRoot(enemy)

	if not enemy or not enemy:IsA("Model") then
		return nil
	end

	local root = enemy:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	if enemy.PrimaryPart then
		return enemy.PrimaryPart
	end

	-- fallback
	for _, obj in ipairs(enemy:GetDescendants()) do

		if obj:IsA("BasePart") then
			return obj
		end

	end

	return nil
end

--==================================================
-- CHECK ENEMY
--==================================================

local function isEnemy(enemy)

	if not enemy or not enemy:IsA("Model") then
		return false
	end

	local humanoid =
		enemy:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	-- Không target player
	if Players:GetPlayerFromCharacter(enemy) then
		return false
	end

	if not getEnemyRoot(enemy) then
		return false
	end

	return true
end

--==================================================
-- FIND ENEMY FOLDERS
--==================================================

local function rebuildEnemyFolders()

	table.clear(enemyFolders)

	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("Folder")
			and obj.Name == "enemyFolder" then

			table.insert(enemyFolders, obj)

		end
	end
end

rebuildEnemyFolders()

-- Tự nhận enemyFolder mới
workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("Folder")
		and obj.Name == "enemyFolder" then

		table.insert(enemyFolders, obj)

	end
end)

workspace.DescendantRemoving:Connect(function(obj)

	for i = #enemyFolders, 1, -1 do

		if enemyFolders[i] == obj then
			table.remove(enemyFolders, i)
		end

	end
end)

--==================================================
-- FIND NEAREST TARGET
--==================================================

local function findNearestEnemy()

	local playerRoot =
		getPlayerRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RANGE

	for _, folder in ipairs(enemyFolders) do

		if folder and folder.Parent then

			-- Không quan tâm room tên gì
			-- Không quan tâm NPC tên gì
			for _, obj in ipairs(folder:GetDescendants()) do

				if obj:IsA("Model")
					and isEnemy(obj) then

					local enemyRoot =
						getEnemyRoot(obj)

					if enemyRoot then

						local distance =
							(
								playerRoot.Position
								- enemyRoot.Position
							).Magnitude

						if distance < nearestDistance then

							nearestDistance = distance
							nearest = obj

						end
					end
				end
			end
		end
	end

	return nearest
end

--==================================================
-- FIND GROUND
--==================================================

local function getGroundPosition(position, character, enemy)

	local params = RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		character,
		enemy
	}

	-- Ray từ trên xuống
	local origin =
		position + Vector3.new(0, 25, 0)

	local direction =
		Vector3.new(0, -80, 0)

	local result =
		workspace:Raycast(
			origin,
			direction,
			params
		)

	if result then

		-- đứng trên mặt đất
		return result.Position
	end

	return nil
end

--==================================================
-- MOVE TO ENEMY
--==================================================

local function moveToEnemy(enemy)

	if not isEnemy(enemy) then
		return
	end

	local character =
		getCharacter()

	local playerRoot =
		getPlayerRoot()

	local enemyRoot =
		getEnemyRoot(enemy)

	if not character
		or not playerRoot
		or not enemyRoot then

		return
	end

	-- Vector nằm ngang
	local offset =
		playerRoot.Position
		- enemyRoot.Position

	local horizontal =
		Vector3.new(
			offset.X,
			0,
			offset.Z
		)

	if horizontal.Magnitude < 0.01 then

		horizontal =
			Vector3.new(0, 0, 1)

	else

		horizontal =
			horizontal.Unit

	end

	-- Vị trí đứng cạnh quái
	local desired =
		enemyRoot.Position
	+ horizontal * ATTACK_DISTANCE

	-- Không teleport xuống lòng đất
	local ground =
		getGroundPosition(
			desired,
			character,
			enemy
		)

	local finalPosition

	if ground then

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		local height = 3

		if humanoid then
			height = humanoid.HipHeight + 2
		end

		finalPosition =
			ground
			+ Vector3.new(0, height, 0)

	else

		-- fallback: giữ Y hiện tại
		finalPosition =
			Vector3.new(
				desired.X,
				playerRoot.Position.Y,
				desired.Z
			)

	end

	-- Nhìn về phía quái nhưng không cúi xuống
	local lookAt =
		Vector3.new(
			enemyRoot.Position.X,
			finalPosition.Y,
			enemyRoot.Position.Z
		)

	character:PivotTo(
		CFrame.lookAt(
			finalPosition,
			lookAt
		)
	)
end

--==================================================
-- AUTO CLICK TOOL
--==================================================

local function autoClick()

	local character =
		getCharacter()

	if not character then
		return
	end

	local tool =
		character:FindFirstChildOfClass("Tool")

	if not tool then
		return
	end

	-- Kích hoạt attack của Tool
	tool:Activate()
end

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function(delta)

	if not ENABLED then
		return
	end

	targetTimer += delta
	attackTimer += delta

	-- Tìm target
	if targetTimer >= TARGET_UPDATE then

		targetTimer = 0

		if not currentTarget
			or not isEnemy(currentTarget) then

			currentTarget =
				findNearestEnemy()

		end
	end

	-- Có target
	if currentTarget
		and isEnemy(currentTarget) then

		-- Áp sát
		moveToEnemy(currentTarget)

		-- Auto click
		if attackTimer >= ATTACK_COOLDOWN then

			attackTimer = 0

			autoClick()

		end

	else

		currentTarget = nil

	end
end)

