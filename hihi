local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

--========================================================
-- SETTINGS
--========================================================

local ENABLED = true

local SEARCH_RANGE = 150
local ATTACK_DISTANCE = 3

local TARGET_UPDATE = 0.25
local ATTACK_COOLDOWN = 0.5

--========================================================
-- VARIABLES
--========================================================

local currentTarget = nil
local enemyFolders = {}

local targetTimer = 0
local attackTimer = 0

--========================================================
-- CHARACTER
--========================================================

local function getCharacter()
	return player.Character
end

local function getPlayerRoot()

	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--========================================================
-- TÌM ROOT NPC
--========================================================

local function getEnemyRoot(enemy)

	if not enemy or not enemy:IsA("Model") then
		return nil
	end

	-- Ưu tiên HumanoidRootPart
	local root =
		enemy:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	-- Nếu có PrimaryPart
	if enemy.PrimaryPart then
		return enemy.PrimaryPart
	end

	-- Fallback: tìm BasePart
	for _, obj in ipairs(enemy:GetDescendants()) do

		if obj:IsA("BasePart") then
			return obj
		end
	end

	return nil
end

--========================================================
-- KIỂM TRA NPC
--========================================================

local function isEnemy(enemy)

	if not enemy or not enemy:IsA("Model") then
		return false
	end

	local humanoid =
		enemy:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	-- Không target người chơi
	if Players:GetPlayerFromCharacter(enemy) then
		return false
	end

	if not getEnemyRoot(enemy) then
		return false
	end

	return true
end

--========================================================
-- TÌM TẤT CẢ enemyFolder
--========================================================

local function rebuildEnemyFolders()

	table.clear(enemyFolders)

	for _, obj in ipairs(workspace:GetDescendants()) do

		if obj:IsA("Folder")
			and obj.Name == "enemyFolder" then

			table.insert(enemyFolders, obj)
		end
	end
end

rebuildEnemyFolders()

-- Map/room mới được tạo
workspace.DescendantAdded:Connect(function(obj)

	if obj:IsA("Folder")
		and obj.Name == "enemyFolder" then

		table.insert(enemyFolders, obj)
	end
end)

workspace.DescendantRemoving:Connect(function(obj)

	for i = #enemyFolders, 1, -1 do

		if enemyFolders[i] == obj then
			table.remove(enemyFolders, i)
		end
	end
end)

--========================================================
-- TÌM QUÁI GẦN NHẤT
--========================================================

local function findNearestEnemy()

	local playerRoot =
		getPlayerRoot()

	if not playerRoot then
		return nil
	end

	local nearest = nil
	local nearestDistance = SEARCH_RANGE

	for _, folder in ipairs(enemyFolders) do

		if folder and folder.Parent then

			-- Không quan trọng room tên gì
			for _, obj in ipairs(folder:GetDescendants()) do

				if obj:IsA("Model")
					and isEnemy(obj) then

					local root =
						getEnemyRoot(obj)

					if root then

						local distance =
							(
								playerRoot.Position
								- root.Position
							).Magnitude

						if distance < nearestDistance then

							nearestDistance = distance
							nearest = obj

						end
					end
				end
			end
		end
	end

	return nearest
end

--========================================================
-- TELEPORT / ÁP SÁT
--========================================================

local function moveToEnemy(enemy)

	if not isEnemy(enemy) then
		return
	end

	local character =
		getCharacter()

	local playerRoot =
		getPlayerRoot()

	local enemyRoot =
		getEnemyRoot(enemy)

	if not character
		or not playerRoot
		or not enemyRoot then

		return
	end

	local difference =
		playerRoot.Position
		- enemyRoot.Position

	local distance =
		difference.Magnitude

	-- Đã gần đủ
	if distance <= ATTACK_DISTANCE then

		playerRoot.CFrame =
			CFrame.lookAt(
				playerRoot.Position,
				enemyRoot.Position
			)

		return
	end

	local direction

	if distance > 0.01 then

		direction =
			difference.Unit

	else

		direction =
			Vector3.new(0, 0, 1)

	end

	-- Đứng cách enemy 3 studs
	local position =
		enemyRoot.Position
	+ direction * ATTACK_DISTANCE

	-- Giữ độ cao nhân vật
	position = Vector3.new(
		position.X,
		playerRoot.Position.Y,
		position.Z
	)

	character:PivotTo(
		CFrame.lookAt(
			position,
			enemyRoot.Position
		)
	)
end

--========================================================
-- AUTO CLICK / TOOL
--========================================================

local function autoAttack()

	local character =
		getCharacter()

	if not character then
		return
	end

	local tool =
		character:FindFirstChildOfClass("Tool")

	if tool then

		-- Kích hoạt attack của Tool
		tool:Activate()

	end
end

--========================================================
-- MAIN LOOP
--========================================================

RunService.Heartbeat:Connect(function(delta)

	if not ENABLED then
		return
	end

	targetTimer += delta
	attackTimer += delta

	-- Tìm target định kỳ để giảm lag
	if targetTimer >= TARGET_UPDATE then

		targetTimer = 0

		if not currentTarget
			or not isEnemy(currentTarget) then

			currentTarget =
				findNearestEnemy()

		end
	end

	if currentTarget
		and isEnemy(currentTarget) then

		moveToEnemy(currentTarget)

		if attackTimer >= ATTACK_COOLDOWN then

			attackTimer = 0

			autoAttack()

		end

	else

		currentTarget = nil

	end
end)

