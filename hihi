-- SETTINGS
--==================================================

local ENABLED = true

local SEARCH_RANGE = 150
local ATTACK_DISTANCE = 3

local TARGET_UPDATE = 0.25
local ATTACK_COOLDOWN = 0.5

--==================================================
-- VARIABLES
--==================================================

local currentTarget = nil
local enemyFolders = {}

local targetTimer = 0
local attackTimer = 0

--==================================================
-- PLAYER
--==================================================

local function getCharacter()
	return player.Character
end

local function getPlayerRoot()

	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- ENEMY
--==================================================

local function getEnemyRoot(enemy)

	if not enemy or not enemy:IsA("Model") then
		return nil
	end

	local root =
		enemy:FindFirstChild("HumanoidRootPart")

	if root and root:IsA("BasePart") then
		return root
	end

	if enemy.PrimaryPart then
		return enemy.PrimaryPart
	end

	-- Nếu không có HumanoidRootPart,
	-- lấy BasePart đầu tiên
	for _, object in ipairs(enemy:GetDescendants()) do

		if object:IsA("BasePart") then
			return object
		end

	end

	return nil
end

local function isEnemy(enemy)

	if not enemy:IsA("Model") then
		return false
	end

	local humanoid =
		enemy:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	if Players:GetPlayerFromCharacter(enemy) then
		return false
	end

	local root =
		getEnemyRoot(enemy)

	if not root then
		return false
	end

	return true
end

