--==================================================
-- HUMANOID
--==================================================

local function GetHumanoid()

	local Character = Player.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChildOfClass("Humanoid")
end

--==================================================
-- FIX RUN ANIMATION
--==================================================

local function UpdateAnimationSpeed()

	local Character = Player.Character

	if not Character then
		return
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return
	end

	local Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		return
	end

	-- Tốc độ animation mặc định của Roblox
	local AnimationSpeed = 1

	if SpeedEnabled then
		-- 16 = tốc độ mặc định
		-- Speed 30 -> animation nhanh hơn
		AnimationSpeed = math.clamp(SPEED / 16, 0.8, 8)
	end

	for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do

		local Priority = Track.Priority

		if Priority == Enum.AnimationPriority.Movement then
			Track:AdjustSpeed(AnimationSpeed)
		end

	end

end

--==================================================
-- APPLY SPEED
--==================================================

local function ApplySpeed()

	local Humanoid = GetHumanoid()

	if not Humanoid then
		return
	end

	if SpeedEnabled then

		Humanoid.WalkSpeed = SPEED

	else

		Humanoid.WalkSpeed = 16

	end

	UpdateAnimationSpeed()

end
